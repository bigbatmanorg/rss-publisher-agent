# Public addressing. Change this one base URL when moving between public/lab deployments.
RSS_PUBLIC_BASE_URL=https://rss.lab.amvc.me
RSS_FEED_PATH=/feed.xml
RSS_ENTRY_PATH=/entries
RSS_MEDIA_PATH=/media
RSS_FILES_PATH=/files

# Optional write/agent authentication. `none` is intended for trusted labs.
RSS_AUTH_MODE=none
# RSS_API_TOKEN=replace-with-a-long-random-token

# Model used by Docker Agent (OpenAI-compatible LiteLLM/vLLM/etc.).
AGENT_BASE_URL=http://pgx.home:4000/v1
AGENT_API_KEY=sk-local
AGENT_MODEL=assistant

# Publisher persistence and upload settings.
RSS_DATA_DIR=/data
RSS_PUBLIC_DIR=/srv/public
RSS_MAX_UPLOAD_BYTES=104857600
RSS_ORPHAN_ASSET_TTL_SECONDS=604800

# Optional embeddings used only to retrieve possible ACTIVE-entry matches.
RSS_EMBEDDINGS_ENABLED=false
# RSS_EMBEDDINGS_BASE_URL=http://embedding-host:4000/v1
# RSS_EMBEDDINGS_API_KEY=sk-local
# RSS_EMBEDDINGS_MODEL=text-embedding-3-small
# RSS_EMBEDDINGS_DIMENSIONS=384

# Private process topology inside the appliance. Normally do not change.
RSS_API_LISTEN_HOST=127.0.0.1
RSS_API_LISTEN_PORT=8765
RSS_MCP_TRANSPORT=streamable-http
RSS_MCP_LISTEN_HOST=127.0.0.1
RSS_MCP_LISTEN_PORT=8766
RSS_PUBLISHER_INTERNAL_MCP_URL=http://127.0.0.1:8766/mcp
RSS_CADDY_SITE=:8080
